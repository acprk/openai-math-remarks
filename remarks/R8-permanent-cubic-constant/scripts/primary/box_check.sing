// Unit test of the BOX lemma: for X in Gamma, Z_X = V(adj entries) on C_X (saturated),
// check (a) X in Gamma, (b) I_Z + (u) subset (s^{q+1},t^{q+1},u), (c) len Z >= (q+1)^2,
// (d) I_Z subset Ann(Lambda)=(s^{q+1},t^{q+1},u^{c+1}) in degrees <= k-1.
// usage: Singular -q -c 'int K=6; int Q=1; int CH=32003; int EX=1;' box_check.sing
// EX=1: X = diag(J_3,J_3) style (two nilpotent Jordan blocks of size 2q+1, rest zero-free random invertible)
// EX=2: random rank r-2 matrix (rank family)
LIB "elim.lib";
proc adjm(matrix A, int n) { matrix B[n][n]; int ii; int jj; intvec rr; intvec cc; int a; int b;
 for(ii=1;ii<=n;ii++){for(jj=1;jj<=n;jj++){ rr=0; cc=0; b=0; for(a=1;a<=n;a++){ if(a!=jj){b++; rr[b]=a;} } b=0; for(a=1;a<=n;a++){ if(a!=ii){b++; cc[b]=a;} }
  B[ii,jj]=(-1)^(ii+jj)*det(submat(A,rr,cc)); }}
 return(B); }
proc cf3(poly p, int a, int b, int cc) { matrix C1=coeffs(p,s); if (nrows(C1)<a+1) {return(0);} poly p1=C1[a+1,1]; matrix C2=coeffs(p1,t); if (nrows(C2)<b+1) {return(0);} poly p2=C2[b+1,1]; matrix C3=coeffs(p2,u); if (nrows(C3)<cc+1) {return(0);} return(C3[cc+1,1]); }
int k=K; int q=Q; int c=k-2*q-1;
system("random", 5);
ring R = (CH), (s,t,u), dp;
if (CH==2) { kill R; ring R = (2,a), (s,t,u), dp; minpoly = a^5+a^2+1; }
matrix X[k][k]; int i; int j; int l;
if (EX==1) {
  int n1 = 2*q+1; int n2 = 2*q+1;
  for (i=1;i<n1;i++){ X[i,i+1]=1; }
  for (i=n1+1;i<n1+n2;i++){ X[i,i+1]=1; }
  for (i=n1+n2+1;i<=k;i++){ for(j=n1+n2+1;j<=k;j++){ X[i,j]=random(1,30); } }
}
if (EX==3) { // m=2 block family: blocks (n1,n2), X11 rank<=r-3, X12 random, rows of K2 zero
  int r=k-2*q; int n1=k-2; int rho=r-3; matrix A[n1][rho]; matrix B[rho][n1];
  for(i=1;i<=n1;i++){for(j=1;j<=rho;j++){A[i,j]=random(-30,30);B[j,i]=random(-30,30);}}
  matrix C=A*B; for(i=1;i<=n1;i++){for(j=1;j<=n1;j++){X[i,j]=C[i,j];}}
  for(i=1;i<=n1;i++){for(j=n1+1;j<=k;j++){X[i,j]=random(-30,30);}}
}
if (EX==4) { // m=3 block upper triangular: sizes (k-4,2,2), diag ranks (r-4,0,0), all upper blocks random
  int r=k-2*q; int n1=k-4; int rho=r-4; matrix A[n1][rho]; matrix B[rho][n1];
  for(i=1;i<=n1;i++){for(j=1;j<=rho;j++){A[i,j]=random(-30,30);B[j,i]=random(-30,30);}}
  matrix C=A*B; for(i=1;i<=n1;i++){for(j=1;j<=n1;j++){X[i,j]=C[i,j];}}
  for(i=1;i<=n1;i++){for(j=n1+1;j<=k;j++){X[i,j]=random(-30,30);}}
  for(i=n1+1;i<=n1+2;i++){for(j=n1+3;j<=k;j++){X[i,j]=random(-30,30);}}
}
if (EX==2) {
  int rr = k-2*q-2; matrix P[k][rr]; matrix Qm[rr][k];
  for (i=1;i<=k;i++){for(j=1;j<=rr;j++){P[i,j]=random(-30,30);Qm[j,i]=random(-30,30);}}
  X = P*Qm;
}
matrix Dg[k][k]; poly th;
for (i=1;i<=k;i++){ if (CH==2) { th = a^i; } else { th = 100*i+random(1,99); } Dg[i,i]=th; }
matrix Id[k][k]; for(i=1;i<=k;i++){Id[i,i]=1;}
matrix M = s*Id + t*Dg + u*X;
poly F = det(M);
matrix Ad = adjm(M,k);
ideal J = F; for(i=1;i<=k;i++){for(j=1;j<=k;j++){ J = J, Ad[i,j]; }}
// (a) gradient condition: [s^q t^q u^c] of every adj entry
int bad=0;
for(i=1;i<=k;i++){for(j=1;j<=k;j++){ if (cf3(Ad[i,j],q,q,c)!=0) {bad=bad+1;} }}
printf("k=%s q=%s c=%s EX=%s char=%s: entries with nonzero [s^q t^q u^c] coefficient = %s (0 <=> X in Gamma)", k,q,c,EX,CH,bad);
def SS = sat(std(J), maxideal(1)); ideal IZ; if (typeof(SS)=="list") { IZ = SS[1]; } else { IZ = SS; }
IZ = std(IZ);
int lenZ = vdim(std(IZ + ideal(u-1)));  // affine length on chart u=1 (Z avoids u=0)
printf("rank X = %s ; dim Z (proj) = %s ; length Z (chart u=1) = %s ; (q+1)^2 = %s", rank(X), dim(IZ)-1, lenZ, (q+1)^2);
ideal Bx = s^(q+1), t^(q+1), u;
ideal IZu = std(IZ + ideal(u));
printf("len S/(I_Z+u) in degrees: affine-dim=%s, sum of Hilbert fn = %s", dim(IZu), vdim(std(IZu+ideal(s,t,u)^(k+2))));
// (b) containment I_Z+(u) in (s^{q+1},t^{q+1},u)
ideal Bs = std(Bx);
int contained = (size(reduce(IZu, Bs))==0);
printf("I_Z+(u) subset (s^{q+1},t^{q+1},u): %s", contained);
// (d) Ann containment in degrees <= k-1
ideal AnnL = std(ideal(s^(q+1),t^(q+1),u^(c+1)));
ideal low; for (i=1;i<=size(IZ);i++){ if (deg(IZ[i])<=k-1) { low = low, IZ[i]; } }
printf("generators of I_Z in deg<=k-1: %s ; all in Ann(Lambda): %s", size(low), size(reduce(low,AnnL))==0);
quit;
